<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Issued agreement: formal PDF to the customer -->
        <record id="mail_template_blanket_issued" model="mail.template">
            <field name="name">Blanket Agreement: Issued</field>
            <field name="model_id" ref="model_blanket_sale_agreement"/>
            <field name="subject">{{ object.company_id.name }} - Blanket Sales Agreement {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="report_template_ids" eval="[(4, ref('action_report_blanket_agreement'))]"/>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent to the customer when a blanket sales agreement is issued</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;">
    <p style="margin:0 0 16px 0;">Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    <p style="margin:0 0 16px 0;">
        We are pleased to confirm that blanket sales agreement
        <strong t-out="object.name or ''">BSA/2026/0001</strong>
        has been formally issued. Please find the full agreement attached to this e-mail.
    </p>
    <table cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse; margin:0 0 20px 0; background-color:#f5f7fa; border-radius:6px;">
        <tr>
            <td style="padding:14px 18px; border-bottom:1px solid #e4e7eb; color:#616e7c;">Validity</td>
            <td style="padding:14px 18px; border-bottom:1px solid #e4e7eb; font-weight:bold;">
                <t t-out="format_date(object.date_start)">01/01/2026</t> - <t t-out="format_date(object.date_end)">31/12/2026</t>
            </td>
        </tr>
        <tr>
            <td style="padding:14px 18px; border-bottom:1px solid #e4e7eb; color:#616e7c;">Agreement Value</td>
            <td style="padding:14px 18px; border-bottom:1px solid #e4e7eb; font-weight:bold;"
                t-out="format_amount(object.amount_total, object.currency_id)">$ 10,000.00</td>
        </tr>
        <tr t-if="object.client_order_ref">
            <td style="padding:14px 18px; color:#616e7c;">Your Reference</td>
            <td style="padding:14px 18px; font-weight:bold;" t-out="object.client_order_ref">PO-123</td>
        </tr>
    </table>
    <p style="margin:0 0 16px 0;">
        Orders placed under this agreement will benefit from the agreed prices and delivery schedule.
        Do not hesitate to contact us should you have any question.
    </p>
    <p style="margin:0;">Kind regards,</p>
    <p style="margin:0; font-weight:bold;" t-out="object.user_id.name or object.company_id.name">Sales Team</p>
    <p style="margin:0; color:#616e7c;" t-out="object.company_id.name">My Company</p>
</div>
            </field>
        </record>

        <!-- Pre-expiration reminder -->
        <record id="mail_template_blanket_reminder" model="mail.template">
            <field name="name">Blanket Agreement: Expiry Reminder</field>
            <field name="model_id" ref="model_blanket_sale_agreement"/>
            <field name="subject">Reminder: Blanket Sales Agreement {{ object.name }} expires on {{ format_date(object.date_end) }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent to the customer before the agreement end date</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;">
    <p style="margin:0 0 16px 0;">Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    <p style="margin:0 0 16px 0;">
        This is a courtesy reminder that blanket sales agreement
        <strong t-out="object.name or ''">BSA/2026/0001</strong>
        will expire on <strong t-out="format_date(object.date_end)">31/12/2026</strong>.
    </p>
    <table cellspacing="0" cellpadding="0" style="width:100%; border-collapse:collapse; margin:0 0 20px 0; background-color:#fff8e6; border-radius:6px;">
        <tr>
            <td style="padding:14px 18px; color:#8a6d1d;">Agreement Value</td>
            <td style="padding:14px 18px; font-weight:bold;" t-out="format_amount(object.amount_total, object.currency_id)">$ 10,000.00</td>
        </tr>
        <tr>
            <td style="padding:14px 18px; color:#8a6d1d;">Consumed to date</td>
            <td style="padding:14px 18px; font-weight:bold;" t-out="format_amount(object.amount_ordered, object.currency_id)">$ 4,000.00</td>
        </tr>
    </table>
    <p style="margin:0 0 16px 0;">
        If you wish to place remaining orders or renew the agreement, please contact us before the end date.
    </p>
    <p style="margin:0;">Kind regards,</p>
    <p style="margin:0; font-weight:bold;" t-out="object.user_id.name or object.company_id.name">Sales Team</p>
    <p style="margin:0; color:#616e7c;" t-out="object.company_id.name">My Company</p>
</div>
            </field>
        </record>

        <!-- Final expiration notice -->
        <record id="mail_template_blanket_expired" model="mail.template">
            <field name="name">Blanket Agreement: Expiration Notice</field>
            <field name="model_id" ref="model_blanket_sale_agreement"/>
            <field name="subject">Blanket Sales Agreement {{ object.name }} has reached its end date</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent to the customer on the agreement end date</field>
            <field name="body_html" type="html">
<div style="margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;">
    <p style="margin:0 0 16px 0;">Dear <t t-out="object.partner_id.name or ''">Customer</t>,</p>
    <p style="margin:0 0 16px 0;">
        Blanket sales agreement <strong t-out="object.name or ''">BSA/2026/0001</strong>
        reaches its end date today, <strong t-out="format_date(object.date_end)">31/12/2026</strong>.
        After this date, new orders can no longer be placed under its terms.
    </p>
    <p style="margin:0 0 16px 0;">
        Thank you for your trust. We would be glad to discuss a renewal of this agreement with you.
    </p>
    <p style="margin:0;">Kind regards,</p>
    <p style="margin:0; font-weight:bold;" t-out="object.user_id.name or object.company_id.name">Sales Team</p>
    <p style="margin:0; color:#616e7c;" t-out="object.company_id.name">My Company</p>
</div>
            </field>
        </record>
    </data>
</odoo>
