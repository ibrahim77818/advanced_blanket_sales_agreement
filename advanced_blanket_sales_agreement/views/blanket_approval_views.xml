<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Roles -->
    <record id="blanket_approval_role_view_tree" model="ir.ui.view">
        <field name="name">blanket.agreement.approval.role.list</field>
        <field name="model">blanket.agreement.approval.role</field>
        <field name="arch" type="xml">
            <list string="Approval Roles">
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags_avatar"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>
    <record id="blanket_approval_role_view_form" model="ir.ui.view">
        <field name="name">blanket.agreement.approval.role.form</field>
        <field name="model">blanket.agreement.approval.role</field>
        <field name="arch" type="xml">
            <form string="Approval Role">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Director"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Members">
                        <field name="user_ids" widget="many2many_tags_avatar" nolabel="1" colspan="2"/>
                    </group>
                    <field name="description" placeholder="Responsibilities of this role..."/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_blanket_approval_role" model="ir.actions.act_window">
        <field name="name">Approval Roles</field>
        <field name="res_model">blanket.agreement.approval.role</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an approval role</p>
            <p>Roles group the users allowed to approve a tier of a blanket agreement.</p>
        </field>
    </record>

    <!-- Templates -->
    <record id="blanket_approval_template_view_tree" model="ir.ui.view">
        <field name="name">blanket.agreement.approval.template.list</field>
        <field name="model">blanket.agreement.approval.template</field>
        <field name="arch" type="xml">
            <list string="Approval Templates">
                <field name="name"/>
                <field name="tier_count" string="Tiers"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>
    <record id="blanket_approval_template_view_form" model="ir.ui.view">
        <field name="name">blanket.agreement.approval.template.form</field>
        <field name="model">blanket.agreement.approval.template</field>
        <field name="arch" type="xml">
            <form string="Approval Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard Agreement Approval"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Tiers" name="tiers">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="approver_type"/>
                                    <field name="role_id" invisible="approver_type != 'role'" required="approver_type == 'role'"/>
                                    <field name="user_id" widget="many2one_avatar_user" invisible="approver_type != 'user'" required="approver_type == 'user'"/>
                                </list>
                            </field>
                            <p class="text-muted">Tiers are approved sequentially, top to bottom. Any member of a role can approve its tier.</p>
                        </page>
                        <page string="Description" name="description">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_blanket_approval_template" model="ir.actions.act_window">
        <field name="name">Approval Templates</field>
        <field name="res_model">blanket.agreement.approval.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an approval template</p>
            <p>Define the sequential approval tiers a blanket sales agreement must pass before issuance.</p>
        </field>
    </record>
</odoo>
