<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_blanket_agreement" model="ir.ui.view">
        <field name="name">sale.order.form.blanket.agreement</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="commercial_partner_id" invisible="1"/>
                <field name="blanket_agreement_id" groups="advanced_blanket_sales_agreement.group_blanket_sale_agreement"
                       options="{'no_create': True}" readonly="state not in ('draft', 'sent') or locked"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="blanket_line_id" optional="hide" options="{'no_create': True}"
                       groups="advanced_blanket_sales_agreement.group_blanket_sale_agreement"/>
            </xpath>
        </field>
    </record>

    <record id="view_sales_order_filter_blanket_agreement" model="ir.ui.view">
        <field name="name">sale.order.search.blanket.agreement</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="blanket_agreement_id" groups="advanced_blanket_sales_agreement.group_blanket_sale_agreement"/>
            </xpath>
        </field>
    </record>
</odoo>
