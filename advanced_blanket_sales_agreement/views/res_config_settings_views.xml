<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_blanket_agreement" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.blanket.agreement</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="after">
                <block title="Blanket Sales Agreements" name="blanket_agreement_setting_container">
                    <setting id="blanket_agreement_enable"
                             help="Long-term customer agreements with approvals, delivery schedules and expiry reminders">
                        <field name="group_blanket_sale_agreement"/>
                        <div class="mt8" invisible="not group_blanket_sale_agreement">
                            <button name="%(advanced_blanket_sales_agreement.action_blanket_approval_template)d"
                                    icon="oi-arrow-right" type="action" string="Approval Templates" class="btn-link"/>
                            <br/>
                            <button name="%(advanced_blanket_sales_agreement.action_blanket_approval_role)d"
                                    icon="oi-arrow-right" type="action" string="Approval Roles" class="btn-link"/>
                        </div>
                    </setting>
                    <setting id="blanket_agreement_approval" string="Approval &amp; Reminders"
                             help="Default approval template and pre-expiration reminder for new agreements"
                             company_dependent="1"
                             invisible="not group_blanket_sale_agreement">
                        <div class="content-group mt16">
                            <div class="row">
                                <label for="blanket_approval_template_id" string="Template" class="col-lg-4 o_light_label"/>
                                <field name="blanket_approval_template_id" class="col-lg-8"/>
                            </div>
                            <div class="row mt8">
                                <label for="blanket_reminder_days" string="Remind" class="col-lg-4 o_light_label"/>
                                <div class="col-lg-8">
                                    <field name="blanket_reminder_days" class="oe_inline"/> days before expiry
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="blanket_agreement_segregation"
                             help="Nobody approves their own agreement or more than one tier of the same submission"
                             company_dependent="1"
                             invisible="not group_blanket_sale_agreement">
                        <field name="blanket_segregation_of_duties"/>
                    </setting>
                    <setting id="blanket_agreement_terms" string="Default Terms &amp; Conditions" class="col-lg-12"
                             help="Pre-filled legal terms of new blanket agreements"
                             company_dependent="1"
                             invisible="not group_blanket_sale_agreement">
                        <field name="blanket_default_terms" class="oe-bordered-editor mt8"
                               placeholder="Agreement terms and conditions..."/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
