#. module: advanced_blanket_sales_agreement
#: model:mail.template,body_html:advanced_blanket_sales_agreement.mail_template_blanket_expired
msgid ""
"<div style=\"margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;\">\n"
"    <p style=\"margin:0 0 16px 0;\">Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        Blanket sales agreement <strong t-out=\"object.name or ''\">BSA/2026/0001</strong>\n"
"        reaches its end date today, <strong t-out=\"format_date(object.date_end)\">31/12/2026</strong>.\n"
"        After this date, new orders can no longer be placed under its terms.\n"
"    </p>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        Thank you for your trust. We would be glad to discuss a renewal of this agreement with you.\n"
"    </p>\n"
"    <p style=\"margin:0;\">Kind regards,</p>\n"
"    <p style=\"margin:0; font-weight:bold;\" t-out=\"object.user_id.name or object.company_id.name\">Sales Team</p>\n"
"    <p style=\"margin:0; color:#616e7c;\" t-out=\"object.company_id.name\">My Company</p>\n"
"</div>\n"
"            "
msgstr ""

#. module: advanced_blanket_sales_agreement
#: model:mail.template,body_html:advanced_blanket_sales_agreement.mail_template_blanket_reminder
msgid ""
"<div style=\"margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;\">\n"
"    <p style=\"margin:0 0 16px 0;\">Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        This is a courtesy reminder that blanket sales agreement\n"
"        <strong t-out=\"object.name or ''\">BSA/2026/0001</strong>\n"
"        will expire on <strong t-out=\"format_date(object.date_end)\">31/12/2026</strong>.\n"
"    </p>\n"
"    <table cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%; border-collapse:collapse; margin:0 0 20px 0; background-color:#fff8e6; border-radius:6px;\">\n"
"        <tr>\n"
"            <td style=\"padding:14px 18px; color:#8a6d1d;\">Agreement Value</td>\n"
"            <td style=\"padding:14px 18px; font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id)\">$ 10,000.00</td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding:14px 18px; color:#8a6d1d;\">Consumed to date</td>\n"
"            <td style=\"padding:14px 18px; font-weight:bold;\" t-out=\"format_amount(object.amount_ordered, object.currency_id)\">$ 4,000.00</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        If you wish to place remaining orders or renew the agreement, please contact us before the end date.\n"
"    </p>\n"
"    <p style=\"margin:0;\">Kind regards,</p>\n"
"    <p style=\"margin:0; font-weight:bold;\" t-out=\"object.user_id.name or object.company_id.name\">Sales Team</p>\n"
"    <p style=\"margin:0; color:#616e7c;\" t-out=\"object.company_id.name\">My Company</p>\n"
"</div>\n"
"            "
msgstr ""

#. module: advanced_blanket_sales_agreement
#: model:mail.template,body_html:advanced_blanket_sales_agreement.mail_template_blanket_issued
msgid ""
"<div style=\"margin:0; padding:0; font-family:'Helvetica Neue', Arial, sans-serif; font-size:14px; color:#1f2933; line-height:1.6;\">\n"
"    <p style=\"margin:0 0 16px 0;\">Dear <t t-out=\"object.partner_id.name or ''\">Customer</t>,</p>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        We are pleased to confirm that blanket sales agreement\n"
"        <strong t-out=\"object.name or ''\">BSA/2026/0001</strong>\n"
"        has been formally issued. Please find the full agreement attached to this e-mail.\n"
"    </p>\n"
"    <table cellspacing=\"0\" cellpadding=\"0\" style=\"width:100%; border-collapse:collapse; margin:0 0 20px 0; background-color:#f5f7fa; border-radius:6px;\">\n"
"        <tr>\n"
"            <td style=\"padding:14px 18px; border-bottom:1px solid #e4e7eb; color:#616e7c;\">Validity</td>\n"
"            <td style=\"padding:14px 18px; border-bottom:1px solid #e4e7eb; font-weight:bold;\">\n"
"                <t t-out=\"format_date(object.date_start)\">01/01/2026</t> - <t t-out=\"format_date(object.date_end)\">31/12/2026</t>\n"
"            </td>\n"
"        </tr>\n"
"        <tr>\n"
"            <td style=\"padding:14px 18px; border-bottom:1px solid #e4e7eb; color:#616e7c;\">Agreement Value</td>\n"
"            <td style=\"padding:14px 18px; border-bottom:1px solid #e4e7eb; font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id)\">$ 10,000.00</td>\n"
"        </tr>\n"
"        <tr t-if=\"object.client_order_ref\">\n"
"            <td style=\"padding:14px 18px; color:#616e7c;\">Your Reference</td>\n"
"            <td style=\"padding:14px 18px; font-weight:bold;\" t-out=\"object.client_order_ref\">PO-123</td>\n"
"        </tr>\n"
"    </table>\n"
"    <p style=\"margin:0 0 16px 0;\">\n"
"        Orders placed under this agreement will benefit from the agreed prices and delivery schedule.\n"
"        Do not hesitate to contact us should you have any question.\n"
"    </p>\n"
"    <p style=\"margin:0;\">Kind regards,</p>\n"
"    <p style=\"margin:0; font-weight:bold;\" t-out=\"object.user_id.name or object.company_id.name\">Sales Team</p>\n"
"    <p style=\"margin:0; color:#616e7c;\" t-out=\"object.company_id.name\">My Company</p>\n"
"</div>\n"
"            "
msgstr ""

